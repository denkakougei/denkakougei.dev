---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/content.css";

const description = "";
---

<BaseLayout title="電化工藝" frontmatter={{ description }}>
    <div class="mainContentInner">
        <div class="content"></div>
    </div>
</BaseLayout>

<style>
    .mainContentInner {
        inline-size: 100%;
        max-inline-size: var(--container-size-md);
        margin-inline: auto;
        display: block grid;
        gap: var(--spacing-8);
    }
</style>
